---

---

<!-- Atmospheric Blobs -->
<div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
  <div
    class="blob-animation absolute -top-24 -left-24 w-96 h-96 bg-primary/10 rounded-full blur-[100px]"
  >
  </div>
  <div
    class="blob-animation absolute top-1/2 -right-48 w-[500px] h-[500px] bg-secondary/10 rounded-full blur-[120px]"
    style="animation-delay: -5s;"
  >
  </div>
  <div
    class="blob-animation absolute -bottom-48 left-1/4 w-[600px] h-[600px] bg-tertiary/5 rounded-full blur-[150px]"
    style="animation-delay: -10s;"
  >
  </div>
</div>

<!-- Hero Section -->
<section
  class="min-h-[80vh] flex flex-col md:flex-row items-center justify-between gap-12 py-12 relative z-10"
  id="about"
>
  <div class="w-full md:w-3/5 space-y-8 text-left">
    <div
      class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full glass-card border-primary/20"
    >
      <span class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></span>
      <span class="text-label-sm font-label-sm text-primary"
        >Available for Opportunities</span
      >
    </div>
    <h1
      class="font-display-lg text-display-lg-mobile md:text-display-lg text-on-surface leading-tight"
    >
      IT Support <span
        class="text-transparent bg-clip-text bg-gradient-to-r from-primary via-secondary to-tertiary"
        >Specialist</span
      >
    </h1>
    <p
      class="font-body-lg text-body-lg text-on-surface-variant max-w-xl leading-relaxed"
    >
      Saya memiliki pengalaman lebih dari 2 tahun sebagai IT Support dengan
      fokus pada troubleshooting hardware, software, serta jaringan LAN & Wi-Fi.
      Terbiasa menangani instalasi, konfigurasi, dan maintenance perangkat IT.
    </p>
    <div class="flex flex-wrap gap-4 pt-4">
      <a
        class="glow-button bg-gradient-to-r from-primary to-secondary text-on-primary-container px-8 py-4 rounded-xl font-bold flex items-center gap-2 group cursor-pointer"
        href="#"
      >
        Download CV
        <span
          class="material-symbols-outlined group-hover:translate-y-1 transition-transform"
          >download</span
        >
      </a>
      <a
        class="glass-card px-8 py-4 rounded-xl font-bold text-on-surface flex items-center gap-2 cursor-pointer"
        href="#contact"
      >
        Hubungi Saya
        <span class="material-symbols-outlined">mail</span>
      </a>
    </div>
  </div>

  <div class="w-full md:w-2/5 flex justify-center relative">
    <div class="absolute inset-0 bg-primary/20 blur-[80px] rounded-full"></div>
    <div
      class="relative w-64 h-64 md:w-80 md:h-80 rounded-3xl glass-card flex items-center justify-center p-8 border-primary/30"
    >
      <img
        src="https://lh3.googleusercontent.com/aida-public/AB6AXuBhQ2kRt3uPFHODxCm8t9S089FhHMXycs8EpCGn0WnVi0O_1_rIvW0T5jFTpiTQJ5ORhVgO32h1owJlCGSwoylmH6Zi8CaMZ4KfmfMSVNQ0hDiiKaSZz_XheeRwpYJlij1mzXD0fZDoDHjearXTxZpxVnX_ZO1uM1_0NSvnfU9hiL2TRh3gT_7BYuGpiDQgMCNUyp7dbHar0tvT59K_3zgturQsK-5MF2gfaug1oe-7CnYdJ7t85dGhrA4sCbjqxW_WJxjTXYHsaS54qA"
        alt="Lukito Awang Nugroho"
        class="w-full h-full object-cover rounded-2xl shadow-2xl"
      />
    </div>
  </div>
</section>
